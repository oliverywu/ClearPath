# All providers default to local. No credentials are needed for the demo.
HOST=127.0.0.1
WEB_PORT=3000
API_PORT=8000
# See README for Chalk's allowlisted feature deployment and credentials.
# CHALK_CLIENT_ID=
# CHALK_CLIENT_SECRET=
# CHALK_ENVIRONMENT=
# CHALK_API_SERVER=https://api.chalk.ai
# CHALK_QUERY_SERVER=<your environment query server URL>
# CHALK_ACCESS_TOKEN=<optional short-lived token>
# CHALK_TIMEOUT_SECONDS=5
# FEATURE_PROVIDER=local
PHOTON_ENABLED=false
# Photon 2.0 beta: create a project and channel in the Photon dashboard first.
# PHOTON_API_KEY=
# PHOTON_PROJECT_ID=
# PHOTON_AGENT_USER_ID=
# PHOTON_RECIPIENT=+14155550123
# PHOTON_PLATFORM=imessage
# PHOTON_API_BASE=https://api.photon.codes
# PHOTON_TIMEOUT_SECONDS=15

# Optional planner assistant. It stays deterministic and offline by default.
ASSISTANT_PROVIDER=local
# Optional AI research and semantic source-change analysis. Outputs remain review-gated.
AI_RESEARCH_PROVIDER=local
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.4-mini
# OPENAI_API_BASE=https://api.openai.com/v1
# OPENAI_TIMEOUT_SECONDS=20

