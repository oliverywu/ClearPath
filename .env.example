# Copy this file to the repository-root .env and fill in the services you use.
# start.py loads it for both the planner API and website. Keep .env out of Git.
HOST=127.0.0.1
WEB_PORT=3000
API_PORT=8000

# Chalk online shipment features. With valid credentials, new plans query Chalk.
# Without them, new plans use the local calculation fallback.
CHALK_CLIENT_ID=
CHALK_CLIENT_SECRET=
CHALK_ENVIRONMENT=
# CHALK_QUERY_SERVER=<your environment query server URL>
# CHALK_API_SERVER=https://api.chalk.ai
# CHALK_TIMEOUT_SECONDS=5
# FEATURE_PROVIDER=auto

# Website map and NASA FIRMS fire data.
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_BROWSER_KEY=
FIRMS_MAP_KEY=
# FIRMS_DAYS=2
# FIRMS_REFRESH_MINUTES=15
# FIRE_CORRIDOR_KM=25

# Optional Photon outbound alerts and inbound iMessage bridge.
PHOTON_ENABLED=false
PHOTON_BRIDGE_ENABLED=false
PHOTON_API_KEY=
PHOTON_PROJECT_ID=
PHOTON_AGENT_USER_ID=
PHOTON_RECIPIENT=
PHOTON_SENDER_ID=
PHOTON_SPACE_ID=
PHOTON_ALERT_SENDER_ID=

# Optional model-written Max answers and AI research.
ASSISTANT_PROVIDER=local
AI_RESEARCH_PROVIDER=local
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional approved-milestone calendar sync.
GOOGLE_CALENDAR_ACCESS_TOKEN=
MICROSOFT_GRAPH_ACCESS_TOKEN=
