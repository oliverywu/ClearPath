# Copy this file to .env.local and add a rotated, server-restricted Google Maps key.
GOOGLE_MAPS_API_KEY=
PORT=8000

# NASA FIRMS active fires (free MAP_KEY: https://firms.modaps.eosdis.nasa.gov/api/map_key/)
FIRMS_MAP_KEY=
# Optional tuning
FIRMS_DAYS=2
FIRMS_REFRESH_MINUTES=15
FIRE_CORRIDOR_KM=25
# Optional browser key for the interactive Google map (restrict by HTTP referrer; Maps JavaScript API only).
GOOGLE_MAPS_BROWSER_KEY=
# Photon (Beta) shipment alerts. Project API key pho_sk_... from the Photon dashboard.
PHOTON_API_KEY=
PHOTON_PROJECT_ID=
# Photon user id of the sending line/agent (pho_usr_...) and default recipient space (pho_spc_...).
PHOTON_SENDER_ID=
PHOTON_SPACE_ID=
