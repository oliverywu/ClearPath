{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/cleared/schemas/research-rule.schema.json",
  "title": "Atomic research requirement",
  "description": "Human-reviewed atomic source evidence. effective_to is exclusive. Synthetic inputs may never be marked verified.",
  "type": "object",
  "required": ["jurisdiction", "rule_type", "requirement_key", "operator", "value", "effective_from", "source_url", "source_title", "source_excerpt", "retrieved_at", "source_tier", "confidence", "review_status"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "jurisdiction": {"type": "string", "minLength": 2},
    "rule_type": {"type": "string", "minLength": 1},
    "requirement_key": {"type": "string", "minLength": 1},
    "operator": {"enum": ["equals", "contains_all", "contains", "excludes", "=", ">=", "<=", "in"]},
    "value": {},
    "effective_from": {"type": "string", "format": "date"},
    "effective_to": {"type": ["string", "null"], "format": "date"},
    "source_url": {"type": "string", "format": "uri", "pattern": "^https?://"},
    "source_title": {"type": "string", "minLength": 1},
    "source_excerpt": {"type": "string", "minLength": 1},
    "retrieved_at": {"type": "string", "format": "date-time"},
    "source_tier": {"enum": ["official", "authoritative_secondary", "modeled", "synthetic"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "review_status": {"enum": ["verified", "needs_review", "synthetic", "retired"]},
    "last_verified_at": {"type": ["string", "null"]},
    "supersedes_id": {"type": ["string", "null"]},
    "source_document_id": {"type": "string"},
    "notes": {"type": "string"}
  },
  "allOf": [
    {"if": {"properties": {"source_tier": {"enum": ["modeled", "synthetic"]}}}, "then": {"properties": {"review_status": {"not": {"const": "verified"}}}}},
    {"if": {"properties": {"requirement_key": {"enum": ["label.languages", "label.mandatory_fields", "label.prohibited_fields", "documents.required"]}}}, "then": {"properties": {"value": {"type": "array", "items": {"type": "string", "minLength": 1}}}}},
    {"if": {"properties": {"requirement_key": {"pattern": "(_days|_business_days)$"}}}, "then": {"properties": {"value": {"type": "integer", "minimum": 0}}}}
  ]
}
