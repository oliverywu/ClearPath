{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/cleared/schemas/dataset.schema.json",
  "title": "Cleared for Takeoff complete dataset",
  "description": "The Python validator additionally enforces references, exclusive intervals, unique IDs and semantic constraints.",
  "type": "object",
  "required": ["id", "as_of", "trial", "config", "jurisdictions", "country_plans", "rules", "routes", "events"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "as_of": {"type": "string", "format": "date"},
    "trial": {"$ref": "#/$defs/trial"},
    "config": {"$ref": "#/$defs/config"},
    "jurisdictions": {"type": "array", "items": {"$ref": "#/$defs/jurisdiction"}},
    "country_plans": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/country_plan"}},
    "rules": {"type": "array", "items": {"$ref": "research-rule.schema.json"}},
    "routes": {"type": "array", "items": {"$ref": "#/$defs/route"}},
    "events": {"type": "array", "items": {"$ref": "#/$defs/event"}},
    "sources": {"type": "array", "items": {"type": "object"}}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1},
    "days": {"type": "integer", "minimum": 0},
    "trial": {
      "type": "object", "required": ["id", "name", "start_date", "manufacturing_origin", "product"],
      "properties": {
        "id": {"$ref": "#/$defs/text"}, "name": {"$ref": "#/$defs/text"}, "start_date": {"type": "string", "format": "date"},
        "manufacturing_origin": {"type": "object", "required": ["city", "country_code"], "properties": {"city": {"$ref": "#/$defs/text"}, "country_code": {"$ref": "#/$defs/text"}}},
        "product": {"type": "object", "required": ["name", "dosage_form", "strength", "blinded", "synthetic", "shelf_life_days", "storage_min_c", "storage_max_c"], "properties": {
          "name": {"$ref": "#/$defs/text"}, "dosage_form": {"$ref": "#/$defs/text"}, "strength": {"$ref": "#/$defs/text"}, "blinded": {"type": "boolean"}, "synthetic": {"type": "boolean"},
          "shelf_life_days": {"type": "integer", "minimum": 1}, "storage_min_c": {"type": "number", "minimum": -273.15}, "storage_max_c": {"type": "number", "minimum": -273.15}}}
      }
    },
    "config": {"type": "object", "required": ["booklet_capacity_pages", "languages_per_page", "base_label_pages", "low_slack_days", "artwork_cost_proxy", "risk_model"], "properties": {
      "booklet_capacity_pages": {"type": "integer", "minimum": 1}, "languages_per_page": {"type": "integer", "minimum": 1}, "base_label_pages": {"type": "integer", "minimum": 1},
      "low_slack_days": {"$ref": "#/$defs/days"}, "artwork_cost_proxy": {"type": "number", "minimum": 0},
      "risk_model": {"type": "object", "required": ["maximum", "blocked_base", "delay_cap", "delay_weight", "minimum", "base", "slack_weight", "synthetic_penalty", "readiness_maximum", "missing_requirement_penalty", "synthetic_readiness_penalty"], "additionalProperties": {"type": "number", "minimum": 0}}
    }},
    "jurisdiction": {"type": "object", "required": ["id", "iso_code", "name", "regulator_name", "regulator_url"], "properties": {
      "id": {"$ref": "#/$defs/text"}, "iso_code": {"$ref": "#/$defs/text"}, "name": {"$ref": "#/$defs/text"}, "regulator_name": {"$ref": "#/$defs/text"}, "regulator_url": {"type": "string", "format": "uri"}, "latitude": {"type": "number"}, "longitude": {"type": "number"}
    }},
    "country_plan": {"type": "object", "required": ["id", "jurisdiction", "target_delivery", "ready_date", "quantity"], "properties": {
      "id": {"$ref": "#/$defs/text"}, "jurisdiction": {"$ref": "#/$defs/text"}, "target_delivery": {"type": "string", "format": "date"}, "ready_date": {"type": "string", "format": "date"}, "quantity": {"type": "integer", "minimum": 1},
      "holidays": {"type": "array", "items": {"type": "string", "format": "date"}}, "site": {"type": "string"}, "depot": {"type": "string"}
    }},
    "route": {"type": "object", "required": ["id", "jurisdiction", "name", "mode", "transit_days", "customs_days", "depot_days", "last_mile_days", "cost_proxy", "storage_min_c", "storage_max_c", "source"], "properties": {
      "id": {"$ref": "#/$defs/text"}, "jurisdiction": {"$ref": "#/$defs/text"}, "name": {"$ref": "#/$defs/text"}, "mode": {"$ref": "#/$defs/text"}, "source": {"$ref": "#/$defs/text"},
      "transit_days": {"$ref": "#/$defs/days"}, "customs_days": {"$ref": "#/$defs/days"}, "depot_days": {"$ref": "#/$defs/days"}, "last_mile_days": {"$ref": "#/$defs/days"}, "cost_proxy": {"type": "number", "minimum": 0},
      "storage_min_c": {"type": "number"}, "storage_max_c": {"type": "number"}, "preferred": {"type": "boolean"}, "synthetic": {"type": "boolean"}
    }},
    "event": {"type": "object", "required": ["id", "jurisdiction", "title", "description", "event_type", "effective_from", "source_url", "source_excerpt"], "properties": {
      "id": {"$ref": "#/$defs/text"}, "jurisdiction": {"$ref": "#/$defs/text"}, "title": {"$ref": "#/$defs/text"}, "description": {"$ref": "#/$defs/text"}, "event_type": {"$ref": "#/$defs/text"}, "synthetic": {"type": "boolean"},
      "effective_from": {"type": "string", "format": "date"}, "effective_to": {"type": ["string", "null"], "format": "date"}, "source_url": {"type": "string", "format": "uri"}, "source_excerpt": {"$ref": "#/$defs/text"},
      "rework_days": {"$ref": "#/$defs/days"}, "permit_delay_days": {"$ref": "#/$defs/days"}, "transit_delay_days": {"$ref": "#/$defs/days"},
      "changes": {"type": "array", "items": {"type": "object", "required": ["requirement_key", "operator", "value"], "properties": {"requirement_key": {"$ref": "#/$defs/text"}, "operator": {"enum": ["equals", "contains_all", "contains", "excludes", "=", ">=", "<=", "in"]}, "value": {}}}},
      "repair_options": {"type": "array", "items": {"type": "object", "required": ["id", "title", "description", "tradeoffs", "action"], "properties": {
        "id": {"$ref": "#/$defs/text"}, "title": {"$ref": "#/$defs/text"}, "description": {"$ref": "#/$defs/text"}, "tradeoffs": {"$ref": "#/$defs/text"}, "recommended": {"type": "boolean"},
        "action": {"enum": ["split_label", "expedite_review", "alternative_route", "expedite_permit"]}, "route_id": {"type": "string"}, "rework_days": {"$ref": "#/$defs/days"}, "permit_delay_days": {"$ref": "#/$defs/days"}
      }}}
    }}
  }
}
